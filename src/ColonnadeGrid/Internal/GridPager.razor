@namespace ColonnadeGrid.Internal
@using BlazorOcticons.Octicons

@*
    The footer pager ColonnadeGrid renders when EnablePaging is set. It only
    reports what the user asked for (a page index or page size) — the grid owns
    the actual page state and reloads data itself.
*@
<nav class="cg-pager" aria-label="Pagination">
    <span class="cg-pager-range">@RangeText</span>
    @if (PageSizeOptions is { Count: > 0 })
    {
        <label class="cg-pager-size">
            Rows per page
            <select class="cg-pager-size-select" value="@PageSize" @onchange="OnPageSizeSelected">
                @foreach (var size in PageSizeChoices)
                {
                    <option value="@size">@size.ToString("N0")</option>
                }
            </select>
        </label>
    }
    <div class="cg-pager-pages">
        <button type="button" class="cg-pager-button cg-pager-first"
                disabled="@(PageIndex <= 0)"
                aria-label="First page"
                @onclick="() => OnPageRequested.InvokeAsync(0)">
            <DoubleChevron Direction="DoubleChevron.ChevronDirection.Left" Color="currentColor" />
        </button>
        <button type="button" class="cg-pager-button cg-pager-previous"
                disabled="@(PageIndex <= 0)"
                aria-label="Previous page"
                @onclick="() => OnPageRequested.InvokeAsync(PageIndex - 1)">
            <ChevronLeft16 Color="currentColor" />
        </button>
        <span class="cg-pager-status" aria-live="polite">Page @((PageIndex + 1).ToString("N0")) of @(PageCount.ToString("N0"))</span>
        <button type="button" class="cg-pager-button cg-pager-next"
                disabled="@(PageIndex >= PageCount - 1)"
                aria-label="Next page"
                @onclick="() => OnPageRequested.InvokeAsync(PageIndex + 1)">
            <ChevronRight16 Color="currentColor" />
        </button>
        <button type="button" class="cg-pager-button cg-pager-last"
                disabled="@(PageIndex >= PageCount - 1)"
                aria-label="Last page"
                @onclick="() => OnPageRequested.InvokeAsync(PageCount - 1)">
            <DoubleChevron Direction="DoubleChevron.ChevronDirection.Right" Color="currentColor" />
        </button>
    </div>
</nav>

@code {

    [Parameter]
    public int PageIndex { get; set; }

    [Parameter]
    public int PageSize { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public IReadOnlyList<int>? PageSizeOptions { get; set; }

    [Parameter]
    public EventCallback<int> OnPageRequested { get; set; }

    [Parameter]
    public EventCallback<int> OnPageSizeRequested { get; set; }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));

    private string RangeText
    {
        get
        {
            if (TotalCount == 0)
            {
                return "No rows";
            }

            var first = (long)PageIndex * PageSize + 1;
            var last = Math.Min(first + PageSize - 1, TotalCount);
            return $"{first:N0}–{last:N0} of {TotalCount:N0}";
        }
    }

    /// <summary>The configured options, plus the current page size if a host set one that isn't among them.</summary>
    private IEnumerable<int> PageSizeChoices =>
        (PageSizeOptions ?? []).Append(PageSize).Distinct().Order();

    private Task OnPageSizeSelected(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var size) ? OnPageSizeRequested.InvokeAsync(size) : Task.CompletedTask;

}
