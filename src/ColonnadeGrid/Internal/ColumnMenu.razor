@namespace ColonnadeGrid.Internal
@typeparam TItem
@using BlazorOcticons.Octicons
@using Microsoft.JSInterop
@using ColonnadeGrid.Abstractions
@using ColonnadeGrid.Models
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    The per-column "..." dropdown: sort, filter, group, hide, and reorder,
    all in one place (matching GitHub Projects' own per-column menu). Two
    local views: the default action list, and a "Filter by values…" view
    that embeds FilterPopover's operator/value editor inline (this menu
    supplies the floating panel chrome; FilterPopover just owns the form).
*@
<div class="cg-column-menu @(IsWideFilterView ? "cg-column-menu-wide" : "")" @ref="_panelRef" @onclick:stopPropagation="true">
    @if (_view == MenuView.Actions)
    {
        @if (Column.Sortable)
        {
            @if (ActiveSortDirection == SortDirection.Ascending)
            {
                <div class="cg-column-menu-item cg-column-menu-item-active">
                    <SortAsc16 Color="currentColor" />
                    <span>Sorted ascending</span>
                    <button type="button" class="cg-column-menu-clear" title="Clear sort" aria-label="Clear sort"
                            @onclick="ClearSortAsync">
                        <X16 Color="currentColor" />
                    </button>
                </div>
                <button type="button" class="cg-column-menu-item" @onclick="() => SetSortAsync(SortDirection.Descending)">
                    <SortDesc16 Color="currentColor" />
                    <span>Sort descending</span>
                </button>
            }
            else if (ActiveSortDirection == SortDirection.Descending)
            {
                <button type="button" class="cg-column-menu-item" @onclick="() => SetSortAsync(SortDirection.Ascending)">
                    <SortAsc16 Color="currentColor" />
                    <span>Sort ascending</span>
                </button>
                <div class="cg-column-menu-item cg-column-menu-item-active">
                    <SortDesc16 Color="currentColor" />
                    <span>Sorted descending</span>
                    <button type="button" class="cg-column-menu-clear" title="Clear sort" aria-label="Clear sort"
                            @onclick="ClearSortAsync">
                        <X16 Color="currentColor" />
                    </button>
                </div>
            }
            else
            {
                <button type="button" class="cg-column-menu-item" @onclick="() => SetSortAsync(SortDirection.Ascending)">
                    <SortAsc16 Color="currentColor" />
                    <span>Sort ascending</span>
                </button>
                <button type="button" class="cg-column-menu-item" @onclick="() => SetSortAsync(SortDirection.Descending)">
                    <SortDesc16 Color="currentColor" />
                    <span>Sort descending</span>
                </button>
            }
        }

        // Sort/filter/group are each conditionally rendered depending on the
        // column's own flags, so a divider hardcoded above any one of them
        // would show up as the first thing in the menu whenever everything
        // before it was absent (e.g. a Groupable-only column with no
        // Sortable/Filterable). Track whether anything has actually
        // rendered above the current point instead, and only draw a divider
        // when there is — Hide/Move always render, so they don't need this
        // tracked past their own sections.
        var hasPrecedingContent = Column.Sortable;

        @if (Column.Filterable)
        {
            @if (hasPrecedingContent)
            {
                <div class="cg-column-menu-divider"></div>
            }
            <button type="button" class="cg-column-menu-item" @onclick="ShowFilterView">
                <Filter16 Color="currentColor" />
                <span>Filter by values…</span>
            </button>
            hasPrecedingContent = true;
        }

        @if (Column.Groupable)
        {
            @if (hasPrecedingContent)
            {
                <div class="cg-column-menu-divider"></div>
            }
            @if (IsActiveGroup)
            {
                <div class="cg-column-menu-item cg-column-menu-item-active">
                    <Rows16 Color="currentColor" />
                    <span>Grouped by field</span>
                    <button type="button" class="cg-column-menu-clear" title="Stop grouping" aria-label="Stop grouping"
                            @onclick="ToggleGroupAsync">
                        <X16 Color="currentColor" />
                    </button>
                </div>
            }
            else
            {
                <button type="button" class="cg-column-menu-item" @onclick="ToggleGroupAsync">
                    <Rows16 Color="currentColor" />
                    <span>Group by values</span>
                </button>
            }
            hasPrecedingContent = true;
        }

        @if (hasPrecedingContent)
        {
            <div class="cg-column-menu-divider"></div>
        }
        <button type="button" class="cg-column-menu-item" disabled="@(!CanHide)" title="@(CanHide ? null : "At least one column must stay visible")"
                @onclick="HideAsync">
            <EyeClosed16 Color="currentColor" />
            <span>Hide field</span>
        </button>

        <div class="cg-column-menu-divider"></div>
        <button type="button" class="cg-column-menu-item" disabled="@IsFirst" @onclick="MoveLeftAsync">
            <ArrowLeft16 Color="currentColor" />
            <span>Move left</span>
        </button>
        <button type="button" class="cg-column-menu-item" disabled="@IsLast" @onclick="MoveRightAsync">
            <ArrowRight16 Color="currentColor" />
            <span>Move right</span>
        </button>
        <button type="button" class="cg-column-menu-item" disabled="@IsFirst" @onclick="MoveToStartAsync">
            <MoveToStart16 Color="currentColor" />
            <span>Move to start</span>
        </button>
        <button type="button" class="cg-column-menu-item" disabled="@IsLast" @onclick="MoveToEndAsync">
            <MoveToEnd16 Color="currentColor" />
            <span>Move to end</span>
        </button>
    }
    else
    {
        <button type="button" class="cg-column-menu-back" @onclick="BackToActions">
            <ArrowLeft16 Color="currentColor" />
            <span>Back</span>
        </button>
        <FilterPopover TItem="TItem"
                       Column="Column"
                       CurrentFilter="CurrentFilter"
                       LoadStats="LoadStats"
                       OnLayoutChanged="RequestReposition"
                       OnApply="OnFilterApplied"
                       OnClear="OnFilterCleared"
                       OnClose="OnClose" />
    }
</div>

@code {
    private enum MenuView
    {
        Actions,
        Filter
    }

    [Parameter, EditorRequired]
    public GridColumnBase<TItem> Column { get; set; } = default!;

    [Parameter, EditorRequired]
    public GridState State { get; set; } = default!;

    [Parameter]
    public FilterDescriptor? CurrentFilter { get; set; }

    /// <summary>Whether this column may be hidden — false when it's the only remaining visible column.</summary>
    [Parameter]
    public bool CanHide { get; set; } = true;

    /// <summary>
    /// The ids of the columns the grid is showing. "Move left/right" swap with
    /// the nearest of these, skipping hidden columns and any the state lists but
    /// the markup no longer declares.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlySet<string> ShownColumnIds { get; set; } = new HashSet<string>();

    /// <summary>When true, the menu opens directly to its "Filter by values…" view instead of the default action list — the filter-indicator icon's shortcut.</summary>
    [Parameter]
    public bool OpenToFilterView { get; set; }

    [Parameter]
    public EventCallback<SortDescriptor?> OnSortChanged { get; set; }

    [Parameter]
    public EventCallback<FilterDescriptor> OnFilterApplied { get; set; }

    [Parameter]
    public EventCallback OnFilterCleared { get; set; }

    /// <summary>Loads this column's stats for its filter editor; returns <c>null</c> when the data source can't provide them.</summary>
    [Parameter]
    public Func<CancellationToken, Task<ColumnStats?>>? LoadStats { get; set; }

    /// <summary>Raised with this column's property name to toggle it as the group-by column.</summary>
    [Parameter]
    public EventCallback<string> OnGroupToggled { get; set; }

    /// <summary>Raised with this column's id to hide it.</summary>
    [Parameter]
    public EventCallback<string> OnHide { get; set; }

    /// <summary>Raised with (columnId, absolute target index) to reorder this column.</summary>
    [Parameter]
    public EventCallback<(string ColumnId, int NewIndex)> OnMove { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private MenuView _view;
    private MenuView? _positionedView;
    private ElementReference _panelRef;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        _view = OpenToFilterView ? MenuView.Filter : MenuView.Actions;
    }

    // Repositions this panel to position:fixed with viewport-measured
    // coordinates so it escapes the hosting page's own scroll containers
    // (e.g. a table wrapper with overflow-x:auto) instead of being clipped
    // by them — the CSS (position:absolute; right:0; top:100%) is left in
    // place as the pre-JS/no-JS fallback. Re-run only when the visible view
    // changes (Actions <-> Filter), since that's the only thing that changes
    // this panel's size — not on every render (e.g. typing into the filter
    // value field).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_positionedView == _view)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ColonnadeGrid/colonnadeGrid.js");
            await _module.InvokeVoidAsync("positionFloatingPanel", _panelRef);
            _positionedView = _view;
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private SortDirection? ActiveSortDirection =>
        State.Sort?.PropertyName == Column.PropertyName ? State.Sort.Direction : null;

    private bool IsActiveGroup => State.GroupByPropertyName == Column.PropertyName;

    private int CurrentIndex => State.Columns.ToList().FindIndex(c => c.Id == Column.Id);

    /// <summary>
    /// The index (within <see cref="GridState.Columns"/>, which includes
    /// hidden columns) of the nearest <em>visible</em> column before this
    /// one, or <c>null</c> if every column before it is hidden. Used instead
    /// of a plain "is index 0" check so "Move left"/"Move to start" are
    /// disabled — and "Move left" actually swaps with a visible neighbor
    /// instead of a hidden one — whenever there's nothing visible to move
    /// past: moving past only-hidden columns would leave the *visible*
    /// column order completely unchanged, which reads as the button having
    /// silently done nothing.
    /// </summary>
    private int? NearestVisibleIndexBefore
    {
        get
        {
            var columns = State.Columns.ToList();
            for (var i = CurrentIndex - 1; i >= 0; i--)
            {
                if (ShownColumnIds.Contains(columns[i].Id))
                {
                    return i;
                }
            }

            return null;
        }
    }

    /// <summary>The "Move right"/"Move to end" counterpart of <see cref="NearestVisibleIndexBefore"/>.</summary>
    private int? NearestVisibleIndexAfter
    {
        get
        {
            var columns = State.Columns.ToList();
            for (var i = CurrentIndex + 1; i < columns.Count; i++)
            {
                if (ShownColumnIds.Contains(columns[i].Id))
                {
                    return i;
                }
            }

            return null;
        }
    }

    private bool IsFirst => NearestVisibleIndexBefore is null;

    private bool IsLast => NearestVisibleIndexAfter is null;

    private async Task SetSortAsync(SortDirection direction)
    {
        await OnSortChanged.InvokeAsync(new SortDescriptor(Column.PropertyName, direction));
        await OnClose.InvokeAsync();
    }

    private async Task ClearSortAsync()
    {
        await OnSortChanged.InvokeAsync(null);
        await OnClose.InvokeAsync();
    }

    private async Task ToggleGroupAsync()
    {
        await OnGroupToggled.InvokeAsync(Column.PropertyName);
        await OnClose.InvokeAsync();
    }

    private async Task HideAsync()
    {
        await OnHide.InvokeAsync(Column.Id);
        await OnClose.InvokeAsync();
    }

    private async Task MoveLeftAsync()
    {
        // Swap with the nearest *visible* column, not the raw index - 1 —
        // otherwise, with a hidden column immediately to the left, this
        // would just swap positions with that hidden column and produce no
        // visible change at all (see NearestVisibleIndexBefore).
        if (NearestVisibleIndexBefore is { } targetIndex)
        {
            await OnMove.InvokeAsync((Column.Id, targetIndex));
        }

        await OnClose.InvokeAsync();
    }

    private async Task MoveRightAsync()
    {
        if (NearestVisibleIndexAfter is { } targetIndex)
        {
            await OnMove.InvokeAsync((Column.Id, targetIndex));
        }

        await OnClose.InvokeAsync();
    }

    private async Task MoveToStartAsync()
    {
        await OnMove.InvokeAsync((Column.Id, 0));
        await OnClose.InvokeAsync();
    }

    private async Task MoveToEndAsync()
    {
        await OnMove.InvokeAsync((Column.Id, State.Columns.Count - 1));
        await OnClose.InvokeAsync();
    }

    private void ShowFilterView() => _view = MenuView.Filter;

    private void BackToActions() => _view = MenuView.Actions;

    /// <summary>The value, range, and date editors need more room than the action list.</summary>
    private bool IsWideFilterView => _view == MenuView.Filter && Column.EffectiveFilterKind != FilterKind.Text;

    /// <summary>Repositions the panel after its next render, e.g. once the filter editor's stats arrive and change its size.</summary>
    private void RequestReposition() => _positionedView = null;
}
