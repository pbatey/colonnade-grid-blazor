<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ColonnadeGrid</PackageId>
    <Version>1.0.0-preview.3</Version>
    <Description>A Blazor data grid with saved views — show/hide, reorder, resize, sort, filter, and group columns, all in serializable state. Works over an in-memory list or your own data provider, with self-contained CSS (no Bootstrap or Tailwind) themeable through CSS custom properties.</Description>
    <PackageReleaseNotes>Column menus now portal to the document body so they anchor to their trigger and are never clipped by host containers (transform/overflow); outside-click still closes them. Redesigned pager to first/prev/"Page X of Y"/next/last with a double-chevron icon. Added GridColumn.MenuTitle. Fixed the rows-per-page selector losing the initial size, the filter popup repositioning, and row highlight/underbar not spanning horizontally scrolled columns.</PackageReleaseNotes>
    <Authors>Phil Batey</Authors>
    <PackageTags>blazor;webassembly;datagrid;grid;table;components</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/pbatey/colonnade-grid-blazor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/pbatey/colonnade-grid-blazor</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorOcticons" Version="1.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ColonnadeGrid.Tests" />
  </ItemGroup>

</Project>
