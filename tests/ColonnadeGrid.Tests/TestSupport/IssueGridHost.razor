@using ColonnadeGrid
@using ColonnadeGrid.Abstractions
@using ColonnadeGrid.Models
@namespace ColonnadeGrid.Tests.TestSupport

@*
    A fixed 4-column table configuration reused across bUnit tests, so
    individual test methods only need to vary Items/DataProvider/State/
    SelectedKeys rather than re-declaring column markup each time.
*@

<ColonnadeGrid TItem="Issue"
                Items="Items"
                DataProvider="DataProvider"
                EnableRowSelection="EnableRowSelection"
                OnRowClick="OnRowClick"
                RowKey="RowKey"
                State="State"
                StateChanged="StateChanged"
                SelectedKeys="SelectedKeys"
                SelectedKeysChanged="SelectedKeysChanged"
                EnablePaging="EnablePaging"
                PageSize="PageSize"
                PageSizeChanged="PageSizeChanged"
                PageIndex="PageIndex"
                PageIndexChanged="PageIndexChanged"
                PageSizeOptions="PageSizeOptions"
                GroupPageSize="GroupPageSize"
                GroupRowBudget="GroupRowBudget"
                GroupsPerLoad="GroupsPerLoad"
                MaxGroupPagesPerRequest="MaxGroupPagesPerRequest"
                OnLoadError="OnLoadError"
                FormatLoadError="FormatLoadError">
    <Columns>
        <GridColumn Field="(Issue x) => x.Title" Title="Title" Sortable="true" Filterable="true" />
        <GridColumn Field="(Issue x) => x.Status" Title="Status" Groupable="true" />
        <GridColumn Field="(Issue x) => x.Priority" Title="Priority" Sortable="true" Filterable="true" />
        <GridColumn Field="(Issue x) => x.Assignee" Title="Assignee" Filterable="true" />
    </Columns>
</ColonnadeGrid>

@code {
    [Parameter] public IEnumerable<Issue>? Items { get; set; }
    [Parameter] public IDataProvider<Issue>? DataProvider { get; set; }
    [Parameter] public bool EnableRowSelection { get; set; }
    [Parameter] public EventCallback<Issue> OnRowClick { get; set; }
    [Parameter] public Func<Issue, string>? RowKey { get; set; }
    [Parameter] public GridState? State { get; set; }
    [Parameter] public EventCallback<GridState> StateChanged { get; set; }
    [Parameter] public IReadOnlySet<string>? SelectedKeys { get; set; }
    [Parameter] public EventCallback<IReadOnlySet<string>> SelectedKeysChanged { get; set; }
    [Parameter] public bool EnablePaging { get; set; }
    [Parameter] public int PageSize { get; set; } = global::ColonnadeGrid.ColonnadeGrid<Issue>.DefaultPageSize;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public EventCallback<int> PageIndexChanged { get; set; }
    [Parameter] public IReadOnlyList<int>? PageSizeOptions { get; set; } = global::ColonnadeGrid.ColonnadeGrid<Issue>.DefaultPageSizeOptions;
    [Parameter] public int GroupPageSize { get; set; } = global::ColonnadeGrid.ColonnadeGrid<Issue>.DefaultGroupPageSize;
    [Parameter] public int? GroupRowBudget { get; set; }
    [Parameter] public int GroupsPerLoad { get; set; } = global::ColonnadeGrid.ColonnadeGrid<Issue>.DefaultGroupsPerLoad;
    [Parameter] public int MaxGroupPagesPerRequest { get; set; } = global::ColonnadeGrid.ColonnadeGrid<Issue>.DefaultMaxGroupPagesPerRequest;
    [Parameter] public EventCallback<Exception> OnLoadError { get; set; }
    [Parameter] public Func<Exception, string>? FormatLoadError { get; set; }
}
